# Port of the frontend dev server. With a deployed agent, it must match the FRONTEND_URL you deployed with.
FRONTEND_PORT=3000

# Local agent started with `agentcore dev`; used while VITE_RUNTIME_URL is empty.
LOCAL_AGENT_URL=http://localhost:8080

# Deployed agent: copy these from the stack outputs. Leave them empty to use the local agent without sign-in.
VITE_RUNTIME_URL=
VITE_COGNITO_DOMAIN=
VITE_CLIENT_ID=
