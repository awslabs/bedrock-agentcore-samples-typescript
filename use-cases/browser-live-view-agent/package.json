{
  "name": "browser-live-view-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.14",
    "@cloudscape-design/components": "^3.0.1416",
    "@cloudscape-design/design-tokens": "^3.0.118",
    "@cloudscape-design/global-styles": "^1.0.72",
    "@strands-agents/sdk": "^1.25.0",
    "bedrock-agentcore": "^0.4.7",
    "fastify": "^5.12.8",
    "playwright": "^1.65.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
