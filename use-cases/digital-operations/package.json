    "@xyflow/react": "^12.9.2",
    "ai": "^5.0.87",
    "aws-amplify": "^6.15.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.552.0",
    "maplibre-gl": "^5.15.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "next": "^15.5.10",
    "prompt-sync": "^4.2.0",
